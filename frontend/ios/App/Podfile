require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.5'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

# Google ML Kit, behind the check-in scanner, ships its arm64 framework for the device only: its
# podspecs pin EXCLUDED_ARCHS[sdk=iphonesimulator*]=arm64, and its arm64 slice is built for iOS,
# not for the simulator. On an Apple Silicon Mac that on its own makes the app impossible to build
# for a simulator, whatever the project says. So the scanner can be left out on purpose:
#   touch SIMULATOR_ONLY && pod install   a simulator build (no scanner: the check-in scan says so)
#   rm SIMULATOR_ONLY && pod install      a device build, the scanner back in
# A file rather than a shell variable on purpose: `npx cap sync` runs `pod install` again, and a
# variable would be lost there. SIMULATOR_ONLY is in .gitignore, so it never leaves this machine.
SIMULATOR_ONLY = File.exist?(File.join(__dir__, 'SIMULATOR_ONLY'))

# ... and the filter has to sit here, not on the pod line below: `cap sync` regenerates the whole
# capacitor_pods helper from the installed plugins on every run (Capacitor CLI, updatePodfile), so
# an `unless SIMULATOR_ONLY` written in there is gone after the next build:mobile. Everything
# outside that one helper survives. (The helper's name must not appear in a comment either: the
# CLI's regex starts at the first occurrence of it, comments included.)
if SIMULATOR_ONLY
  module DropMlKitForSimulator
    def pod(name, *args, **kwargs)
      return if name.to_s == 'CapacitorMlkitBarcodeScanning'
      super
    end
  end
  Pod::Podfile.prepend(DropMlKitForSimulator)
end

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'AparajitaCapacitorSecureStorage', :path => '../../node_modules/@aparajita/capacitor-secure-storage'
  pod 'CapacitorMlkitBarcodeScanning', :path => '../../node_modules/@capacitor-mlkit/barcode-scanning'
  pod 'CapacitorApp', :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorFilesystem', :path => '../../node_modules/@capacitor/filesystem'
  pod 'CapacitorLocalNotifications', :path => '../../node_modules/@capacitor/local-notifications'
  pod 'CapacitorPushNotifications', :path => '../../node_modules/@capacitor/push-notifications'
  pod 'CapacitorShare', :path => '../../node_modules/@capacitor/share'
  pod 'CapacitorSplashScreen', :path => '../../node_modules/@capacitor/splash-screen'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)
  # assertDeploymentTarget only lifts a pod to 14.0, below what current Xcode supports, so every
  # build warned about the pods. Set them to the app's own target (the platform line above and
  # IPHONEOS_DEPLOYMENT_TARGET in the project, both 15.5), not to some lower number: a pod built
  # for an iOS the app does not run on buys nothing and keeps the two out of step.
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
    end
  end
end
