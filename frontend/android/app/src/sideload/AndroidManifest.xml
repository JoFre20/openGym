<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The in-app updater (InstallPlugin) hands the downloaded APK to the system installer.
         Only in this build: Google Play updates the Play build itself. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Native push (FCM) is in the APK and the Play build, not F-Droid. The channel is created
         by lib/native-push.js on first registration; this tells FCM which one to use. -->
    <application>
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="@string/default_notification_channel_id" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_opengym" />
    </application>
</manifest>
