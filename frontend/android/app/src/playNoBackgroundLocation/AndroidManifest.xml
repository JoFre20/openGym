<?xml version="1.0" encoding="utf-8" ?>
<!-- Only with -PplayWithoutBackgroundLocation (app/build.gradle): the Play build without
     background location, should Google Play refuse its declaration for the gym reminder. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" tools:node="remove" />
    <!-- This source set replaces the Play manifest, so keep the native-push settings here too. -->
    <application>
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="@string/default_notification_channel_id" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_opengym" />
    </application>
</manifest>
